# =========================
# Python / Flask .gitignore
# =========================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
.venv/

# Environment variables
*.env
.env.*

# Flask instance folder (stores uploads, etc.)
instance/
*.db
*.sqlite3
db.sqlite3-*
*.sqlite3-shm
*.sqlite3-wal

# PyInstaller
*.manifest
*.spec

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log

# Local settings.  Anchored to the repo root ON PURPOSE: an unanchored
# `config.py` also matches app/config.py, which is the application's central
# settings module and must ship. It was silently excluded, so a clone had code
# reading settings.vote_consensus with nothing defining it - the app crashed on
# import and the tuned thresholds never reached a deployment made by git.
/config.py

# OS generated files
.DS_Store
Thumbs.db

# Uploaded media
media/
!media/.gitkeep

# ---- added 2026-08-25: keep the repo to source only -------------------
# Biometric / personal data. The face_id_users export README states it
# "contains personal and biometric data" - it must never enter version control.
face_id_users/

# Model weights: 781 MB of ONNX. Tracked out of band, restored from
# models/README or the training runs they were exported from.
models/
*.onnx
*.pt

# Runtime output: clips, debug captures, snapshots, logs, the SQLite db.
data/
staticfiles/
db.sqlite3
*.sqlite3
db.sqlite3-*
*.sqlite3-shm
*.sqlite3-wal

# Local caches
.pytest_cache/

# Licensing: the private key mints licences for ANY machine - never commit it.
vendor_private_key.pem
licence.key
*.onnx.enc

# --- never publish: licence + key material ----------------------------------
# The licence carries the key material the model vault derives its AES key
# from, so committing one hands over the ability to decrypt the shipped
# weights - the exact thing the encryption exists to prevent. `licence.key`
# was already covered; the per-site names from docs/DEPLOY_AISCAN.md were not,
# and a routine `git add -A` after following that guide would have published
# one. Match any licence key, anywhere.
*.key
licence*.key
license*.key
!**/public*.key
